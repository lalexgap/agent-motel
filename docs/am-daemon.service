# Install together with am-tmux.service; see service-lifecycle.md for migration.
[Unit]
Description=Agent Motel daemon
Wants=am-tmux.service
After=am-tmux.service

[Service]
Type=exec
ExecStart=/bin/sh -lc 'exec am __daemon'
Environment=AGENTMGR_SYSTEMD=1
UnsetEnvironment=AGENTMGR_AGENT AGENTMGR_HOME AM_HOST TMUX
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
