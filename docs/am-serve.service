# systemd user unit for `am serve` — the HTTP API that lets other clients
# (a phone app, scripts) watch and message the fleet. Optional; run it on the box the
# agents live on.
#
#   mkdir -p ~/.config/systemd/user
#   See service-lifecycle.md before installing on an existing fleet.
#   cp docs/am-{tmux,daemon,serve}.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now am-serve
#   loginctl enable-linger $USER   # user units run without an active login
#
# SECURITY: the API can spawn agents and run commands, so it MUST sit behind a
# network gate. By default it binds 127.0.0.1 — either set config.apiBind to a
# tailnet IP, or keep loopback and front it with Caddy/tailscale serve. Never
# expose it to the public internet with only the bearer token. See
# docs/ios-app-exploration.md §4e–4f.
#
# Get the API bearer token with:  am token
# sh -l so PATH picks up ~/.bun/bin from the profile.

[Unit]
Description=Agent Motel fleet HTTP API
Wants=am-tmux.service am-daemon.service
After=network-online.target am-tmux.service am-daemon.service

[Service]
Type=simple
ExecStart=/bin/sh -lc 'exec am serve'
Environment=AGENTMGR_SYSTEMD=1
UnsetEnvironment=AGENTMGR_AGENT AGENTMGR_HOME AM_HOST TMUX
Restart=on-failure

[Install]
WantedBy=default.target
